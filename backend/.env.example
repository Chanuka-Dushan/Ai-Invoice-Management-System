# InvoiceAI Backend Configuration

# Server Port
PORT=4000

# Database Connection (MySQL / MariaDB or Vercel Postgres)
DATABASE_URL="mysql://root:@localhost:3306/invoiceai"

# JWT Authentication
JWT_SECRET="replace_with_a_secure_random_jwt_secret_key"
JWT_EXPIRES_IN="7d"

# AI Service Configuration (OpenRouter, OpenAI, Gemini)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Voice Transcription (Groq Whisper or OpenAI Whisper)
GROQ_API_KEY=""
TRANSCRIPTION_API_KEY=""

# SMTP / Email Service Configuration
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="InvoiceAI <no-reply@invoiceai.com>"

# App URLs
APP_URL="http://localhost:5173"
API_URL="http://localhost:4000"
